<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StaffCore RD</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        <style >
                body {
                    font-family: 'IBM Plex Sans', 'Segoe UI', sans-serif;
                    background-color: #f8f9fa;
                    display: flex;
                    flex-direction: column;
                    min-height: 100vh;
                    color: #2b2f33;
                }

                h1, h2, h3, h4, h5, h6 {
                    font-weight: 600;
                    letter-spacing: -0.01em;
                }

                .navbar-brand, .btn, .nav-link, th {
                    font-family: 'IBM Plex Sans', 'Segoe UI', sans-serif;
                }

                /* Degradado corporativo para el Navbar */
                .bg-gradient-primary {
                    background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
                }

                main {
                    flex: 1;
                }
                /* Efecto hover en las filas de las tablas */
                .table-hover tbody tr:hover {
                    background-color: #f1f4f8 !important;
                    transition: background-color 0.3s ease;
                }

                /* Tarjetas de estadísticas: estilo claro y minimalista */
                .stat-card {
                    background-color: #ffffff;
                    border: 1px solid #e9ecef !important;
                    border-radius: 0.6rem;
                }

                    .stat-card h6 {
                        font-size: 0.75rem;
                        letter-spacing: 0.04em;
                        font-weight: 500;
                    }

                    .stat-card h3 {
                        font-weight: 600;
                    }
        </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-gradient-primary shadow mb-4 py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4" asp-controller="Staff" asp-action="Index">
                    🏢 StaffCore <span class="text-warning">RD</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
                    <ul class="navbar-nav me-auto ps-3">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-controller="Staff" asp-action="Index">Gestión de Personal</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @using System.Security.Claims
                        @if (User.Identity.IsAuthenticated)
                        {
                            // Extrae el NombreCompleto de los Claims. Si no lo tiene (usuarios viejos), muestra el correo.
                            var nombreUsuario = User.Claims.FirstOrDefault(c => c.Type == "NombreCompleto")?.Value ?? User.Identity.Name;

                            <li class="nav-item me-3">
                                <a asp-controller="Account" asp-action="MiPerfil" class="nav-link text-light bg-white bg-opacity-10 rounded-pill px-3 text-decoration-none shadow-sm">
                                    <small>👤 Hola,</small> <strong>@nombreUsuario</strong>
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-warning text-dark fw-bold btn-sm rounded-pill px-3 shadow-sm">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-white me-2" asp-controller="Account" asp-action="Login">Iniciar Sesión</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-light text-primary fw-bold btn-sm rounded-pill px-4 shadow-sm" asp-controller="Account" asp-action="Register">Registrarse</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 border-0 border-start border-5 border-success" role="alert">
                    <strong>¡Éxito!</strong> @TempData["Exito"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()

        </main>
    </div>

    <footer class="bg-white border-top shadow-sm py-4 mt-auto">
        <div class="container text-center">
            <div class="mb-2">
                <a asp-controller="Staff" asp-action="Privacy" class="text-decoration-none text-muted fw-semibold mx-2 hover-primary">Políticas de Privacidad</a>
                <span class="text-muted">|</span>
                <a href="#" class="text-decoration-none text-muted fw-semibold mx-2">Términos de Uso</a>
            </div>
            <small class="text-muted">
                &copy; @DateTime.Now.Year - <strong>StaffCore RD</strong>. Universidad Central del Este (UCE). Todos los derechos reservados.
            </small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>